# Copy this file to .env and fill in real values before running the server.

# Port the Express server listens on
PORT=3000

# Long random string used to sign admin login JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Admin Console credentials.
# Username is plain text. Password must be stored as a bcrypt hash, never plain text.
# Generate the hash with:   npm run hash-password -- "yourPasswordHere"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste_the_bcrypt_hash_here

# --- MongoDB ---
# Connection string for your MongoDB cluster (a free Atlas cluster is
# enough for this scale). See server/db.js.
MONGODB_URI=paste_your_mongodb_connection_string_here

# --- Kafka (streaming ingestion layer — server/kafka.js) ---
# Comma-separated list of broker host:port pairs.
# Local dev (docker-compose.yml's Redpanda container): localhost:19092
# Redpanda Serverless / Cloud, Confluent Cloud, etc: copy from your
# broker's console — usually one or more "seed-*.<provider>.com:9092" hosts.
KAFKA_BROKERS=localhost:19092

# Leave KAFKA_USERNAME/KAFKA_PASSWORD unset for the local docker-compose
# broker (no auth). A managed cloud broker will give you these plus the
# SASL mechanism it expects (commonly scram-sha-256 or scram-sha-512) —
# check its console/connection-details page for the exact values.
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_SSL=true is required by basically every managed cloud broker.
# Leave it false (or unset) for the local docker-compose broker.
KAFKA_SSL=false

# Which consumer group server/worker.js joins. Run multiple worker
# processes with the SAME group id to horizontally scale — Kafka splits
# the topic's partitions across them automatically.
KAFKA_CONSUMER_GROUP=varshanet-scoring-workers

# Port server/worker.js's standalone health endpoint listens on when
# deployed as its own service (ignored when RUN_WORKER_INPROCESS=true).
WORKER_PORT=3001

# Local-dev convenience only — starts the Kafka consumer inside the same
# process as the web app (`npm start`), so you don't need a second
# terminal running `npm run worker` just to see queued reports get scored.
# Leave this unset/false for any real deployment (see server/worker.js).
RUN_WORKER_INPROCESS=false
